spring:
  application:
    name: structure-gateway
  cloud:
    gateway:
      routes:
        - id: auth-center
          uri: http://localhost:18002
          predicates:
            - Path=/auth/**
          filters:
            - StripPrefix=1
        - id: user-center
          uri: http://localhost:18001
          predicates:
            - Path=/user/**
          filters:
            - StripPrefix=1
      globalcors:
        cors-configurations:
          '[/**]':
            allowedOrigins: "*"
            allowedMethods: "*"
            allowedHeaders: "*"
  redis:
    host: ${REDIS_HOST:172.24.20.15}
    port: ${REDIS_PORT:6379}
    password: ${REDIS_PASSWORD:123456}
    database: ${REDIS_DATABASE:0}
    lettuce:
      pool:
        max-active: 8
        max-idle: 8
        min-idle: 0
        max-wait: -1ms
  rabbitmq:
    host: ${RABBITMQ_HOST:172.24.20.15}
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USERNAME:root}
    password: ${RABBITMQ_PASSWORD:123456}
    virtual-host: ${RABBITMQ_VHOST:/}
    listener:
      simple:
        acknowledge-mode: manual
        prefetch: 1
        retry:
          enabled: true
          initial-interval: 1000
          max-attempts: 3
management:
  endpoints:
    web:
      exposure:
        include: health,info,gateway
  endpoint:
    health:
      show-details: always
structure:
  gateway:
    token-check:
      enabled: true
      min-token-length: 20
    tenant-identification:
      enabled: true
      default-tenant-id: default
      max-tenant-id-length: 64
    rate-limit:
      enabled: true
      whitelist-tenants:
        - 1
        - 2
    replay-check:
      enabled: true
      timestamp-tolerance-ms: 300000
      require-timestamp: true
      require-signature: false
      require-nonce: false
      min-nonce-length: 8
      max-nonce-length: 64
      min-signature-length: 32
      nonce-expire-minutes: 10
      secret-key: your-secret-key-change-in-production
    trace-config:
      enabled: true                    # 是否启用链路追踪
      require-request-id: true         # 是否要求请求 ID
    # 设备识别配置
    device-identification:
      enabled: true                    # 是否启用设备识别
      require-device-id: false         # 是否要求设备 ID
      max-device-id-length: 64        # 设备 ID 最大长度
      log-device-id: true              # 是否在日志中记录设备 ID
    # 排除路径（跳过 Token、限流等检查，但仍执行 Trace 和 Replay 检查）
    excluded-paths:
      - /auth/**
      - /actuator/**
    security-excluded-paths:
      - /user/**

logging:
  level:
    cn.structured.cloud.gateway: DEBUG
    org.springframework.cloud.gateway: INFO
